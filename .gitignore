.gradle/
.kotlin/
**/build/
.local/
*.log
runtime/models/*.traineddata
runtime/native/*
!runtime/native/.gitkeep
runtime/opencv/*.dll
runtime/opencv/*.jar

# Installers are uploaded as GitHub Release assets.
output/*.msi

# Local credentials and user databases must never enter source control.
.env
.env.*
*.pem
*.pfx
*.p12
*.key
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Generated plaintext QA workbooks, page images and PDF copies stay local.
# Structured validation metadata remains eligible for source control.
/output/validation/**/*.xlsx
/output/validation/**/*.png
/output/validation/**/*.pdf

# Questionnaire PDF inputs are local test data, not repository assets.
/input test/**/*.pdf
/input-test/**/*.pdf
